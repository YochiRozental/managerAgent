# Anthropic (Claude) API key — https://console.anthropic.com/
ANTHROPIC_API_KEY=
# OpenAI API key — https://platform.openai.com/api-keys — נדרש רק אם AI_*_PROVIDER=openai
OPENAI_API_KEY=

# ── ניתוב מודלים (src/ai/) ─────────────────────────────────────────────────────
# ה-router בוחר FAST מול SMART לפי סוג הבקשה; כאן בוחרים איזה provider+model כל tier מפעיל.
# בלי להגדיר כלום → ברירת מחדל = anthropic (בדיוק כמו היום, לא נשבר כלום).
# FAST  = פעולות פשוטות: שאלות עובד, עדכוני סטטוס, tool-use פשוט, סיכומים קצרים.
# SMART = ניתוח מצב, תכנון סדר עבודה, זיהוי חריגות, החלטות, בקשות עמומות/ארוכות, ו-fallback.
AI_FAST_PROVIDER=anthropic
AI_FAST_MODEL=claude-haiku-4-5-20251001
AI_SMART_PROVIDER=anthropic
AI_SMART_MODEL=claude-sonnet-5
# מעבר ל-GPT (דוגמה — GPT-5.4 mini): AI_FAST_PROVIDER=openai / AI_FAST_MODEL=gpt-5.4-mini
# providers תקפים: anthropic | openai   ·   שמות מודלים — לפי התיעוד הרשמי של הספק
# MODEL_FAST / MODEL_SMART (שמות ישנים) עדיין נתמכים כ-alias ל-AI_*_MODEL.

# AI_COST_LOGGING=false כדי לכבות חישוב עלות משוערת בלוגים (ברירת מחדל: מופעל)
AI_COST_LOGGING=true

# Monday.com personal API token — Avatar -> Admin -> API
MONDAY_API_TOKEN=
MONDAY_BOARD_ID=

# Google OAuth client (from google-credentials.json downloaded via Google Cloud Console)
# credentials.json itself is loaded from ./google-credentials.json, not from env.

# Comma-separated WhatsApp JIDs allowed to talk to the agent (e.g. 9725XXXXXXXX@s.whatsapp.net)
ALLOWED_WHATSAPP_JIDS=

# Google account you authorized on the OAuth consent screen (used for self-tests / calendar invites)
USER_EMAIL=

TIMEZONE=Asia/Jerusalem
