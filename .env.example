# Anthropic (Claude) API key — https://console.anthropic.com/
ANTHROPIC_API_KEY=
# OpenAI API key — https://platform.openai.com/api-keys — נדרש רק אם AI_*_PROVIDER=openai
OPENAI_API_KEY=

# ── ניתוב מודלים (src/ai/) ─────────────────────────────────────────────────────
# ה-router בוחר FAST מול SMART לפי סוג הבקשה; כאן בוחרים איזה provider+model כל tier מפעיל.
# בלי להגדיר כלום → ברירת מחדל = anthropic (בדיוק כמו היום, לא נשבר כלום).
# FAST  = פעולות פשוטות: שאלות עובד, עדכוני סטטוס, tool-use פשוט, סיכומים קצרים.
# SMART = ניתוח מצב, תכנון סדר עבודה, זיהוי חריגות, החלטות, בקשות עמומות/ארוכות, ו-fallback.
AI_FAST_PROVIDER=anthropic
AI_FAST_MODEL=claude-haiku-4-5-20251001
AI_SMART_PROVIDER=anthropic
AI_SMART_MODEL=claude-sonnet-5
# מעבר ל-GPT (דוגמה — GPT-5.4 mini): AI_FAST_PROVIDER=openai / AI_FAST_MODEL=gpt-5.4-mini
# providers תקפים: anthropic | openai   ·   שמות מודלים — לפי התיעוד הרשמי של הספק
# MODEL_FAST / MODEL_SMART (שמות ישנים) עדיין נתמכים כ-alias ל-AI_*_MODEL.

# AI_COST_LOGGING=false כדי לכבות חישוב עלות משוערת בלוגים (ברירת מחדל: מופעל)
AI_COST_LOGGING=true

# Monday.com personal API token — Avatar -> Developers -> My Access Tokens
MONDAY_API_TOKEN=
MONDAY_BOARD_ID=

# Google OAuth client (from google-credentials.json downloaded via Google Cloud Console)
# credentials.json itself is loaded from ./google-credentials.json, not from env.
# ה-refresh token נשמר ב-data/google-token.json (מעבירים לשרת בנפרד, לא ב-git).

# Comma-separated WhatsApp JIDs allowed to talk to the agent (e.g. 9725XXXXXXXX@s.whatsapp.net)
ALLOWED_WHATSAPP_JIDS=

# Google account you authorized on the OAuth consent screen (used for self-tests / calendar invites)
USER_EMAIL=

TIMEZONE=Asia/Jerusalem
ENABLE_VOICE_TRANSCRIPTION=false

# ── חלונית העובד (src/server/) ────────────────────────────────────────────────
PORT=3001
# חתימת עוגיית ההפעלה. ערך אקראי ארוך. סיבוב = כל העובדים יצטרכו להיכנס מחדש.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=
# חתימת קישורי הכניסה האישיים (magic links). ערך אקראי ארוך, נפרד מ-SESSION_SECRET.
# סיבוב = כל הקישורים האישיים הישנים מתבטלים.
ACCESS_SECRET=
# כתובת חיצונית לבניית הקישורים האישיים (npm run links). למשל https://manager-agent.gotlib.biz
PUBLIC_URL=
# true = כניסה רק דרך קישור אישי; מסך בחירת השם ו-/api/login מכובים. מומלץ בפרודקשן.
REQUIRE_ACCESS_LINK=true

# ── מתזמן / מנוע הבקרה (src/ops/scheduler.ts) ─────────────────────────────────
# שעות מקומיות (TIMEZONE). ברירות מחדל: גיבוי 6:00, סבב יומי 7:00 (א׳–ה׳), דוח שבועי 8:00 (א׳).
BACKUP_HOUR=6
CONTROL_SCAN_HOUR=7
WEEKLY_REPORT_HOUR=8

# ── פריסה ─────────────────────────────────────────────────────────────────────
# Caddy רץ על ה-host (systemd), לא בקונטיינר. הדומיין נקבע ב-/etc/caddy/Caddyfile.
# domain: manager-agent.gotlib.biz

# ── oauth2-proxy (שכבת אימות Google, profile "auth" ב-docker-compose) ─────────
# OAuth client "Web application" ב-Google Cloud Console, redirect URI:
#   https://manager-agent.gotlib.biz/oauth2/callback
OAUTH2_PROXY_CLIENT_ID=
OAUTH2_PROXY_CLIENT_SECRET=
# ערך אקראי: python3 -c 'import os,base64; print(base64.urlsafe_b64encode(os.urandom(32)).decode())'
OAUTH2_PROXY_COOKIE_SECRET=
OAUTH2_PROXY_REDIRECT_URL=https://manager-agent.gotlib.biz/oauth2/callback
